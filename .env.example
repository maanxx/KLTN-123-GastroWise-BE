PORT=3001

# MongoDB Connection String (Replace with your own cluster URL)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster01.../gastrowise?appName=Cluster01

# JWT Secret for Authentication
JWT_SECRET=your_jwt_secret_key_here

# URLs
FRONTEND_URL=http://localhost:3000
AI_SERVICE_URL=http://127.0.0.1:5000

# Google OAuth 2.0 Credentials (For Login with Google)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google Gemini AI API Key (For Sentiment Analysis & Hashtag Generator)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
