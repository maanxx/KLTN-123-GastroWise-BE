# ==============================================================================
# GASTROWISE - ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# --- Gateway & Service Ports ---
PORT=3001
CORE_SERVICE_PORT=3001
PLANNING_SERVICE_PORT=3003
GATEWAY_PORT=8080

# --- MongoDB Connections (Microservices Database per Service) ---
MONGODB_URI=mongodb+srv://<username>:<password>@cluster01.../gastrowise?appName=Cluster01
MONGODB_URI_CORE=mongodb+srv://<username>:<password>@cluster01.../gastro_core?appName=Cluster01
MONGODB_URI_PLANNING=mongodb+srv://<username>:<password>@cluster01.../gastro_planning?appName=Cluster01

# --- Authentication & JWT Secrets ---
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# --- Mutual Microservice Authentication Mesh ---
INTERNAL_SERVICE_KEY=your_internal_service_key_at_least_32_chars
INTERNAL_AI_KEY=your_internal_ai_key_at_least_32_chars

# --- Inter-Service Network Endpoints ---
CORE_SERVICE_URL=http://localhost:3001
PLANNING_SERVICE_URL=http://localhost:3003
AI_SERVICE_URL=http://127.0.0.1:5000

# --- Frontend & CORS Whitelist ---
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3003,http://localhost:8080,http://localhost:8081,http://localhost:19006

# --- Google OAuth 2.0 Credentials (For Login with Google) ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- External AI Key ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- SMTP Configuration for Email OTP Password Reset ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_project_email@gmail.com
SMTP_PASS=your_16_digit_app_password
